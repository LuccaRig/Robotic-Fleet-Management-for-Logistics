digraph Arquitetura {
 graph [rankdir=TB, compound=true, splines=polyline, nodesep=.37, ranksep=.70, pad=.2, bgcolor="white", fontname="DejaVu Sans", fontsize=12, label="ARQUITETURA DA ETAPA 1 — PROCESSOS, THREADS E SINCRONIZAÇÃO", labelloc=t, labeljust=c];
 node [shape=box, style="rounded,filled", color="#3A5270", fillcolor="#EAF1F9", fontname="DejaVu Sans", fontsize=9, margin=".13,.10"];
 edge [fontname="DejaVu Sans", fontsize=8, color="#496782", arrowsize=.7];
 subgraph cluster_central { label="PROCESSO CENTRAL (C++) — fluxo de coordenação sequencial"; color="#305980"; fillcolor="#F2F7FC"; style="rounded,filled"; fontsize=11;
 manager [label="Gestor de Robôs\nposix_spawn() / waitpid()\nPID, geração e prontidão"];
 organizer [label="Organizador de Logística\nmissões e barreira lógica\nacoplamento / descarga"];
 corridors [label="Controle de Passagens\nfilas, reservas e capacidade\nliberação por sensores"];
 hardware [label="Adaptador Hardware Local\nsetpoint → sensor simulado\nsem GUI na Etapa 1"];
 events [label="Registro de eventos\nprodutor no ciclo central"];
 collector [label="THREAD Coletora de Dados\nstd::queue (limite 10.000)\nmutex + condition_variable",fillcolor="#DDEEE6",color="#328267"];
 sqlite [label="SQLite (disco)\nruns / robot_events\ncargo_transports / cargo_members",shape=cylinder,fillcolor="#FFEBD5",color="#B37639"];
 manager -> organizer [label="novo agente / disponibilidade"];
 organizer -> corridors [label="reservas / permissões"];
 corridors -> hardware [label="comando validado"];
 organizer -> events [label="eventos de missão",constraint=false];
 events -> collector [label="fila protegida\nnotificação CV", color="#328267"];
 collector -> sqlite [label="transações\nfora do lock",color="#B37639"];
 }
 subgraph cluster_robot { label="UM PROCESSO POR ROBÔ (C++), replicado N vezes"; color="#BA8A25"; fillcolor="#FFF9E9"; style="rounded,filled"; fontsize=11;
 receiver [label="Receptor IPC\ndecodifica e valida\ngeração / sequência"];
 shared [label="ESTADO LOCAL COMPARTILHADO\nmissão, rota, sensores, bateria, falha\nstd::mutex + condition_variable",fillcolor="#FDEDC0",color="#A98225"];
 nav [label="THREAD Navegação — 100 ms nominal\ncomandos / solicitações / confirmações"];
 status [label="THREAD Status — 500 ms nominal\nsensores / disponibilidade / distância"];
 sender [label="Canal emissor IPC\nstd::timed_mutex + poll()\nespera limitada"];
 receiver -> shared [label="atualiza estado\nsob mutex"];
 shared -> nav [label="leitura / aviso",dir=both];
 shared -> status [label="leitura / aviso",dir=both];
 nav -> sender [label="requisições"];
 status -> sender [label="publicação status"];
 }
 manager -> receiver [label="SOCKET UNIX SOCK_STREAM\nquadros: prefixo 4 bytes\ncomandos / sensores / confirmação",color="#1974A8",penwidth=1.9,dir=both,ltail=cluster_central,lhead=cluster_robot];
 sender -> organizer [label="SOCKET UNIX SOCK_STREAM\nstatus / solicitação / ACK\nidentificador + geração + seq.",color="#1974A8",penwidth=1.9,constraint=false];
}
